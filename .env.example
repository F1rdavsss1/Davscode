# ── Сайт ────────────────────────────────────────────────────────────
# Публичный адрес сайта без слэша в конце. Используется для canonical,
# sitemap и проверки Origin в /api/lead.
NEXT_PUBLIC_SITE_URL=https://davscode.ru

# Контакты. Пустое значение — ссылка скрывается на сайте.
NEXT_PUBLIC_TELEGRAM_USERNAME=https://t.me/DavsCode
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=https://t.me/DavsCodebot
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/davs_code?psln=NXFzbGdzbzhwZjEz
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Яндекс Метрика (номер счётчика). Пусто — аналитика не подключается.
NEXT_PUBLIC_YM_ID=

# ── База данных (PostgreSQL) ───────────────────────────────────────
# Для Neon/Supabase используйте pooled-строку подключения.
DATABASE_URL=postgres://user:password@host:5432/davscode?sslmode=require

# ── Telegram ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Числовой Telegram ID владельца: администратор и получатель уведомлений.
TELEGRAM_OWNER_ID=
# Случайная строка (A-Z, a-z, 0-9, _ и -), проверяется в заголовке
# X-Telegram-Bot-Api-Secret-Token на /api/telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=

# ── Google Sheets ──────────────────────────────────────────────────
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Приватный ключ сервисного аккаунта. Переводы строк можно записать как \n.
GOOGLE_PRIVATE_KEY=

# ── Служебное ──────────────────────────────────────────────────────
# Секрет для /api/cron/jobs (Vercel Cron передаёт его как Bearer-токен).
CRON_SECRET=
# Секрет для хеширования IP в rate limit (IP в открытом виде не хранится).
IP_HASH_SECRET=
# Лимит принятых заявок с одного IP в час.
LEAD_RATE_LIMIT_PER_HOUR=5
# Заголовок с IP клиента, который выставляет доверенная инфраструктура.
# На Vercel по умолчанию x-real-ip. Локально без него лимит общий.
TRUSTED_IP_HEADER=
# Часовой пояс для отчётов /stats.
REPORT_TIMEZONE=Europe/Moscow

# Размер пула соединений с БД на один процесс (для serverless хватает 1–3).
DATABASE_POOL_MAX=

# Необязательно: адрес прокси или локального Bot API сервера вместо https://api.telegram.org.
TELEGRAM_API_BASE=
